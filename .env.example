# Non-secret runtime configuration
BITBROWSER_API_URL=http://127.0.0.1:54345
BITBROWSER_WINDOW_NAME=us001_codex
SUB2API_BASE_URL=https://sub2apipro.opencodex.uk
SUB2API_API_PREFIX=/api/v1

# Inject one administrator credential at runtime; never commit its value.
# SUB2API_ADMIN_TOKEN=
# SUB2API_ADMIN_API_KEY=
# SUB2API_ADMIN_COOKIE=

# Workstation inventory API credential. Inject from OpenBao at runtime; never
# copy the production value from WORKSTATION_AUTOMATION_API.md into this file.
WORKSTATION_AUTOMATION_BASE_URL=https://workstation.opencodex.uk
# WORKSTATION_AUTOMATION_TOKEN=

# Runtime-only OpenAI account import values. Inject these through the process
# environment; do not put real values in this file or .runtime/admin.env.
# OPENAI_ACCOUNT_EMAIL=
# OPENAI_ACCOUNT_PASSWORD=
# OPENAI_TOTP_SECRET=
# OPENAI_PHONE=1##########
# SMS_ACCESS_URL=https://example.invalid/api/sms/access?token=runtime-only
